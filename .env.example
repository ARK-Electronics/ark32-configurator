# ─── Sevalla: Application → Environment variables ───────────────────────────
# Mark these as available at **Runtime** (and Build only if needed).
# After linking a Sevalla Database, copy the **internal** connection string.

# Required for admin / sponsors / sessions
DATABASE_URL=mysql://user:password@your-db-internal-host:3306/dbname

# Optional alternatives to DATABASE_URL:
# MYSQL_HOST=your-db-internal-host
# MYSQL_PORT=3306
# MYSQL_USER=user
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=dbname

# Seed (yarn prisma:seed) — not required for app boot
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# Optional
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
# REDIS_HOST=your-redis-internal-host

# Firmware releases: without MinIO, lists assets from GitHub (default ARK-Electronics/ARK32).
# Optional token raises API rate limits.
# GITHUB_TOKEN=
# GITHUB_FIRMWARE_OWNER=ARK-Electronics
# GITHUB_FIRMWARE_REPO=ARK32
# GITHUB_BOOTLOADER_OWNER=ARK-Electronics
# GITHUB_BOOTLOADER_REPO=ARK32

# Optional MinIO / S3-compatible object storage (legacy production path)
# MINIO_URL=minio.example.com
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_PORT=443
# MINIO_USE_SSL=true

