# Required at runtime on Sevalla (Application → Environment variables)
# Use the INTERNAL connection string from Sevalla Database hosting.
# Do NOT use 127.0.0.1 / localhost — that is only for local docker-compose.
DATABASE_URL=mysql://user:password@your-db-internal-host:3306/dbname

# Or instead of DATABASE_URL, set discrete vars:
# MYSQL_HOST=your-db-internal-host
# MYSQL_PORT=3306
# MYSQL_USER=user
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=dbname

# Optional
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
REDIS_HOST=
