# Copy to stack.env for docker compose:
#   cp stack.env.example stack.env

PREFIX=ark32-
DOMAIN=localhost

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=am32
MYSQL_USER=am32
MYSQL_PASSWORD=am32password
MYSQL_HOST=mariadb
MYSQL_PORT=3306

DATABASE_URL=mysql://am32:am32password@mariadb:3306/am32
REDIS_HOST=cache

